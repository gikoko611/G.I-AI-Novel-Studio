# Copy to .env for local use. Never put provider keys in frontend code.
DATABASE_PATH=./data/novel_studio.db
OUTPUT_DIR=./data/exports
# Choose: openai_compatible or gemini
AI_PROVIDER=openai_compatible
# Example: https://api.groq.com/openai/v1
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Gemini settings are used only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_CHAPTERS_PER_REQUEST=1
